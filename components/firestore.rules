rules_version = '2';

// DEMO RULES ONLY. Any signed-in doctor can read/write any referral.
// This is fine for a standby demo with a handful of trusted accounts, but
// should NOT be used once this becomes the real system — at that point,
// bring back department-scoped and role-scoped checks like the ones in
// the full Referral Bridge project.
service cloud.firestore {
  match /databases/{database}/documents {
    match /referrals/{referralId} {
      allow read, write: if request.auth != null;
    }
  }
}
